    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet rawDocxFile = null;\nlet postedDocxFile = null;\nlet mp4File = null;\n\nfor (const item of items) {\n  const json = item.json || {};\n  const name = json.name || '';\n  const mimeType = json.mimeType || '';\n\n  // 1. 동영상 파일 감지 (.mp4, .mov, video 타입)\n  const isVideo = name.endsWith('.mp4') || name.endsWith('.mov') || mimeType.startsWith('video/');\n  \n  // 2. 문서 파일 감지 (.docx, Google Docs 문서, 확장자 없는 순수 제목 문서)\n  const isDoc = name.endsWith('.docx') || name.endsWith('.doc') || mimeType === 'application/vnd.google-apps.document' || mimeType.includes('wordprocessingml') || (!isVideo && name.length > 0);\n\n  if (isVideo) {\n    mp4File = json;\n  } else if (isDoc) {\n    if (name.includes('[POSTED]')) {\n      postedDocxFile = json;\n    } else {\n      rawDocxFile = json;\n    }\n  }\n}\n\nconst effectiveDocx = rawDocxFile || postedDocxFile;\nconst needTrack1 = rawDocxFile !== null;\nconst needTrack2 = effectiveDocx !== null && mp4File !== null;\n\nreturn [{\n  json: {\n    needTrack1,\n    needTrack2,\n    rawDocxFile,\n    effectiveDocx,\n    mp4File,\n    todayFolderId: $('4. Organize Folder IDs').item.json.todayFolderId,\n    completedFolderId: $('4. Organize Folder IDs').item.json.completedFolderId\n  }\n}];"
      },
