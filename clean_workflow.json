    {
      "parameters": {
        "jsCode": "const returnData = [];\n\nfor (let i = 0; i < $input.all().length; i++) {\n  let buffer = null;\n\n  // n8n 격리 바이너리 저장소에서 실제 파일 버퍼 끌어오기\n  try {\n    buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n  } catch (e) {\n    const item = $input.all()[i];\n    const keys = Object.keys(item.binary || {});\n    if (keys.length > 0) {\n      buffer = await this.helpers.getBinaryDataBuffer(i, keys[0]);\n    }\n  }\n\n  if (!buffer) {\n    returnData.push({ json: { text: \"\" } });\n    continue;\n  }\n\n  const str = buffer.toString('utf-8');\n\n  // XML 태그 정제 및 순수 한글 텍스트만 추출\n  const matches = str.match(/<w:t[^>]*>(.*?)<\\/w:t>/g);\n  let cleanText = \"\";\n\n  if (matches && matches.length > 0) {\n    cleanText = matches.map(m => m.replace(/<[^>]+>/g, '').trim()).filter(t => t.length > 0).join(' ');\n  } else {\n    cleanText = str.replace(/<[^>]+>/g, ' ').replace(/[\\x00-\\x1F\\x7F-\\x9F]/g, ' ').trim();\n  }\n\n  returnData.push({ json: { text: cleanText } });\n}\n\nreturn returnData;"
