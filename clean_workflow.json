      "parameters": {
        "jsCode": "const items = $input.all();\nconst todayStr = $('2. Get Today & Yesterday Dates').item.json.todayFolder;\nconst yesterdayStr = $('2. Get Today & Yesterday Dates').item.json.yesterdayFolder;\n\nlet todayFolderId = null;\nlet completedFolderId = null;\nlet yesterdayFolderId = null;\n\nfor (const item of items) {\n  const name = item.json.name || '';\n  if (name === todayStr) todayFolderId = item.json.id;\n  if (name === '완료') completedFolderId = item.json.id;\n  if (name === yesterdayStr) yesterdayFolderId = item.json.id;\n}\n\nreturn [{\n  json: {\n    todayFolderId,\n    todayFolderName: todayStr,\n    completedFolderId,\n    yesterdayFolderId,\n    hasYesterdayFolder: yesterdayFolderId !== null,\n    hasTodayFolder: todayFolderId !== null\n  }\n}];"
